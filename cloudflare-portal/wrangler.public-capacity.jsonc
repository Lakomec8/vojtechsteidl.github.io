{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vojtechsteidl-public-capacity",
  "main": "src/public-capacity-entry.ts",
  "compatibility_date": "2026-08-19",
  "routes": [
    {
      "pattern": "capacity.vojtechsteidl.eu",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vojtechsteidl-portal",
      "database_id": "34173dc8-5cb4-4e2a-9fb6-3de6d9e72de1"
    }
  ],
  "send_email": [
    {
      "name": "BOOKING_EMAIL",
      "destination_address": "vojtasteidl@seznam.cz"
    }
  ]
}
